FROM node:24.19.0-bookworm-slim AS build
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --ignore-scripts --no-fund
COPY apps/web/ ./
ARG BREAKROOM_API_ORIGIN=http://api:8000
ARG BREAKROOM_TEAM_API_ORIGIN=http://127.0.0.1:8001
ENV BREAKROOM_API_ORIGIN=$BREAKROOM_API_ORIGIN BREAKROOM_TEAM_API_ORIGIN=$BREAKROOM_TEAM_API_ORIGIN NEXT_TELEMETRY_DISABLED=1
RUN npm run build
USER node
EXPOSE 3000
CMD ["node", "node_modules/next/dist/bin/next", "start", "--hostname", "0.0.0.0", "--port", "3000"]
