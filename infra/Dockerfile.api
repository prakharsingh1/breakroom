FROM python:3.12.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY apps/api/requirements.lock /app/apps/api/requirements.lock
RUN python -m pip install --no-cache-dir -r /app/apps/api/requirements.lock
COPY packages/breakroom-core /app/packages/breakroom-core
RUN python -m pip install --no-cache-dir /app/packages/breakroom-core
COPY apps/api/breakroom_api /app/apps/api/breakroom_api
USER 65532:65532
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "breakroom_api.main:app", "--app-dir", "/app/apps/api", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-proxy-headers", "--limit-concurrency", "32", "--timeout-keep-alive", "5"]
