# Copy to .env.production and replace every placeholder. Never commit real values.
BREAKROOM_TEAM_PUBLIC_ORIGIN=https://breakroom.example.com
# URL-encode the database password; require TLS for external PostgreSQL.
BREAKROOM_TEAM_DATABASE_URL=postgresql+psycopg://breakroom:REPLACE_WITH_PRIVATE_PASSWORD@database.example.com:5432/breakroom?sslmode=require
BREAKROOM_SMTP_HOST=smtp.example.com
BREAKROOM_SMTP_PORT=465
BREAKROOM_SMTP_MODE=ssl
BREAKROOM_SMTP_FROM=accounts@example.com
BREAKROOM_SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
BREAKROOM_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
