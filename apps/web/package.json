{
  "name": "breakroom-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "dev:vinext": "vinext dev --port 3001",
    "build:cloudflare": "node scripts/build-cloudflare-catalog.mjs && npm run typecheck:cloudflare && BREAKROOM_CLOUDFLARE_BUILD=1 vinext build",
    "preview:cloudflare": "wrangler dev --config dist/server/wrangler.json --ip 127.0.0.1 --port 8787",
    "deploy:cloudflare": "wrangler deploy --config dist/server/wrangler.json",
    "check:cloudflare": "node scripts/check-cloudflare.mjs",
    "typecheck:cloudflare": "tsc --noEmit --skipLibCheck --strict --module ESNext --moduleResolution bundler --target ES2022 --resolveJsonModule cloudflare/worker.ts"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.54.8",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.3.0",
    "wrangler": "4.131.1"
  },
  "type": "module"
}
